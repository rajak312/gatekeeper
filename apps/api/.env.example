# ---------------------------------------------------------------------------
# Gatekeeper API - copy to apps/api/.env for local development.
# Every variable is validated with zod at startup (the process exits with a
# readable list of problems if something is missing or malformed).
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4500
LOG_LEVEL=debug

# Runtime connection (pooled in production, e.g. Neon "-pooler" host).
DATABASE_URL=postgresql://gatekeeper:gatekeeper@localhost:5435/gatekeeper
# Direct (non-pooled) connection used by `prisma migrate`. Falls back to DATABASE_URL.
DIRECT_URL=postgresql://gatekeeper:gatekeeper@localhost:5435/gatekeeper

# Public issuer identifier = the origin the browser sees. The web app proxies
# /oauth, /.well-known and /api to this API, so it's the web origin.
ISSUER_URL=http://localhost:3500
# Origin of the hosted login / consent UI (same as ISSUER_URL in the proxied setup).
WEB_URL=http://localhost:3500

# >= 32 chars. Derives the AES-256-GCM key that encrypts private signing keys and
# TOTP secrets at rest. Generate with: openssl rand -base64 48
# Changing it makes existing signing keys / TOTP secrets undecryptable.
KEY_ENCRYPTION_SECRET=dev-only-key-encryption-secret-please-change-0123456789

# Secure + __Host- prefixed cookies. Defaults to true when NODE_ENV=production.
COOKIE_SECURE=false
# Express "trust proxy": hop count or subnet list. Used for client IPs (rate limits, audit).
TRUST_PROXY=loopback

# Demo behaviour: protects seeded accounts, generates sample data, periodic reset.
DEMO_MODE=true
DEMO_RESET_CRON=0 */6 * * *
# Seed demo users/clients on boot when the database is empty.
SEED_ON_BOOT=true

# outbox (store in DB, view in admin console) | console (log only)
MAIL_DRIVER=outbox

# Optional tuning (seconds)
# ACCESS_TOKEN_TTL=900
# ID_TOKEN_TTL=3600
# SESSION_TTL=604800
# RETIRED_KEY_TTL=86400
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_SECONDS=900
